{
  "manifest_version": 3,
  "name": "ashish-speechify",
  "short_name": "speechify",
  "version": "0.1.0",
  "description": "Reads any page or selection aloud with a natural voice that runs on your device, highlighting each sentence and word.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Read this page aloud (Alt+Shift+R)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "offscreen", "storage", "contextMenus"],
  "host_permissions": ["https://huggingface.co/*", "https://*.hf.co/*"],
  "options_page": "options.html",
  "commands": {
    "toggle-reading": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Read the page (or selection) aloud, or pause and resume"
    },
    "read-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Read the selected text aloud"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
