{
  "manifest_version": 3,
  "name": "ashish-speechify",
  "short_name": "speechify",
  "version": "0.2.1",
  "description": "Reads any page or selection aloud with a natural voice that runs on your device. Fast read (bold word starts) and speed read (one word at a time) too.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Read this page aloud (Alt+Shift+R)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "options_page": "options.html",
  "commands": {
    "toggle-reading": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Read the page (or selection) aloud, or pause and resume"
    },
    "read-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Read the selected text aloud"
    },
    "fast-read": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Fast read: bold the start of every word on the page (press again to turn off)"
    },
    "speed-read": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Speed read the page or selection, one word at a time"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
